# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080
DATABASE_URL=postgresql://user:pass@host:5432/pyre
REDIS_URL=redis://host:6379
LOG_LEVEL=info

# Public origins
WEB_ORIGIN=https://pyre.fun
API_ORIGIN=https://api.pyre.fun
# Wildcard app domain (apps served at <slug>.APP_DOMAIN). Leave empty to use path routing API_ORIGIN/a/<slug>
APP_DOMAIN=pyre.fun

# Shared secret between api and runner for internal calls + feed publish
INTERNAL_SECRET=change-me
# Signing key for app session cookies
SESSION_SECRET=change-me

# ── Auth (Google login + custodial wallets) ────────────────────────────────────
GOOGLE_CLIENT_ID=

# ── Robinhood Chain (chain id 4663, Arbitrum Nitro, native ETH) ────────────────
# JSON-RPC over HTTPS. The public endpoint is rate-limited and has no websocket; use an Alchemy
# Robinhood Chain app URL in production (https://<app>.g.alchemy.com/v2/<key>).
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Optional websocket RPC for log subscriptions (Alchemy). Empty = poll over HTTP.
RPC_WSS_URL=
CHAIN_ID=4663
# 32-byte hex BIP-32 master seed. Users derive at m/44'/60'/0'/0/{User.walletIndex} (index 0 = platform treasury);
# apps derive at m/44'/60'/1'/0/{App.keypairIndex}. The server signs; browsers never see keys.
PLATFORM_MASTER_SEED_HEX=
# Treasury address derived from the seed at index 0. Informational only (ops dashboards, docs); never read for signing.
TREASURY_WALLET=
# $PYRE token address (a PONS v2 launch made from the treasury). Empty until launched.
PYRE_TOKEN=
# Override the refundable launch stake (wei). Default LAUNCH_STAKE_WEI = 2000000000000000 (0.002 ETH).
LAUNCH_STAKE_WEI=
# USDG (Global Dollar, Paxos) — 6 decimals, EIP-3009 + EIP-2612. App payments are relayed USDG transfers.
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
# PONS v2 launchpad contracts (https://docs.ponsfamily.com/v2)
PONS_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
PONS_LAUNCH_AND_BUY=0xe33E9E479dF8802cb0866d5d05258bEc4cF62948
PONS_FEE_ESCROW=0xd3AFEB2a57f70eF218Aa82451c51B2fb0416Ac9e
PONS_MEME_HOOK=0xE5e702641Ea86F4ae6cC3cDaeD2B886f976Be044
# Uniswap v4 on Robinhood Chain (graduated coins trade here; https://developers.uniswap.org/docs/protocols/v4/deployments)
UNIV4_POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951
UNIV4_UNIVERSAL_ROUTER=0x8876789976dEcBfCbBbe364623C63652db8C0904
UNIV4_QUOTER=0x8Dc178eFB8111BB0973Dd9d722ebeFF267c98F94
UNIV4_STATE_VIEW=0xF3334192D15450CdD385c8B70e03f9A6bD9E673b
# Blockscout explorer (links, holders API). The WAF rejects bare Node fetches; the chain client sends browser-like headers.
BLOCKSCOUT_URL=https://robinhoodchain.blockscout.com
# Optional Blockscout API key for higher rate limits on the holders/token endpoints
BLOCKSCOUT_API_KEY=
# Model-credit funding (runner): the founder's Zentro card session, captured once from a logged-in
# browser as {"cookies":[{"name":"connect.sid",...}],"localStorage":{"cardhub_*":...}} (one line).
# When set, the runner mints a fresh USDC (Ethereum) deposit address per top-up and pays it from
# treasury ETH via Relay (see docs/economics.md). Leave empty to accrue the credits slice on the
# ledger without moving it off-treasury; /ops then shows `credits_accrue_only`.
ZENTRO_STATE=
# GitHub webhook HMAC secret (set the same value on each pyre-<slug> repo webhook)
GITHUB_WEBHOOK_SECRET=

# ── Agents ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
E2B_API_KEY=
# Optional prebuilt E2B template (4GB VM + preinstalled Agent SDK/chromium/app deps); falls back to "base".
# Build: npx tsx apps/runner/scripts/build-e2b-template.ts pyre-builder
E2B_TEMPLATE=
GITHUB_TOKEN=
GITHUB_OWNER=
# Model overrides (defaults in @pyre/shared MODELS)
MODEL_ROUTINE=
MODEL_ARCHITECT=
MODEL_REVIEWER=

# ── Growth (X API v2, user context) ───────────────────────────────────────────
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ── Web (Vite, prefixed VITE_) ────────────────────────────────────────────────
VITE_API_ORIGIN=https://api.pyre.fun
VITE_GOOGLE_CLIENT_ID=
VITE_APP_DOMAIN=pyre.fun
VITE_PYRE_TOKEN=
VITE_CHAIN_ID=4663
VITE_EXPLORER_URL=https://robinhoodchain.blockscout.com
